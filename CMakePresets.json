{
	"version": 6,
	"cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"GAMEENGINE_RESOURCES_DIR": "$env{GAMEENGINE_RESOURCES_DIR}",
				"GAMEENGINE_BUILD_TESTS": "ON"
			}
		},
		{
			"name": "windows-msvc-base",
			"hidden": true,
			"inherits": "base",
			"description": "MSVC via Ninja. Run inside a VS developer environment (cmake/scripts/dev-shell.ps1).",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl"
			},
			"architecture": { "value": "x64", "strategy": "external" },
			"toolset": { "value": "host=x64", "strategy": "external" },
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
		},
		{
			"name": "windows-msvc-debug",
			"displayName": "Windows MSVC Debug",
			"inherits": "windows-msvc-base",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
		},
		{
			"name": "windows-msvc-release",
			"displayName": "Windows MSVC Release",
			"inherits": "windows-msvc-base",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
		},
		{
			"name": "windows-msvc-ci",
			"displayName": "Windows MSVC CI (warnings as errors, strict dependency lock)",
			"inherits": "windows-msvc-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"GAMEENGINE_WARNINGS_AS_ERRORS": "ON",
				"GAMEENGINE_STRICT_DEPENDENCY_LOCK": "ON"
			}
		},
		{
			"name": "linux-gcc-debug",
			"displayName": "Linux GCC Debug (unverified)",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++",
				"CMAKE_BUILD_TYPE": "Debug"
			},
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
		}
	],
	"buildPresets": [
		{ "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug" },
		{ "name": "windows-msvc-release", "configurePreset": "windows-msvc-release" },
		{ "name": "windows-msvc-ci", "configurePreset": "windows-msvc-ci" },
		{ "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug" }
	],
	"testPresets": [
		{
			"name": "base",
			"hidden": true,
			"output": { "outputOnFailure": true },
			"execution": { "noTestsAction": "error", "stopOnFailure": false }
		},
		{ "name": "windows-msvc-debug", "inherits": "base", "configurePreset": "windows-msvc-debug" },
		{ "name": "windows-msvc-release", "inherits": "base", "configurePreset": "windows-msvc-release" },
		{ "name": "windows-msvc-ci", "inherits": "base", "configurePreset": "windows-msvc-ci" },
		{ "name": "linux-gcc-debug", "inherits": "base", "configurePreset": "linux-gcc-debug" }
	]
}

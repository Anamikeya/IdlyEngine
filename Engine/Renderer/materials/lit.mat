material {
    name: EditorLit,
    parameters: [
        {type: float3, name: baseColor},
        {type: float, name: roughness},
        {type: float, name: metallic},
        {type: sampler2d, name: baseColorMap}
    ],
    requires: [uv0],
    shadingModel: lit,
    culling: none
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // Mesh UVs have v = 0 at an image's first row; Filament samples that row at v = 1 (gltfio flips the same way).
        vec2 uv = vec2(getUV0().x, 1.0 - getUV0().y);
        material.baseColor = vec4(materialParams.baseColor * texture(materialParams_baseColorMap, uv).rgb, 1.0);
        material.roughness = materialParams.roughness;
        material.metallic = materialParams.metallic;
    }
}

// The selection outline (Milestone 5, slice 7): one full-screen triangle over the viewport's finished image. A pixel
// outside the mask that lies within `width` pixels of it takes the outline's color, fading over its last pixel. A pixel
// inside the mask is left as it is, so the outline wraps the outer silhouette only: no inner edges, no box, and nothing
// of the model shown through itself. Where the mask is hidden behind something else, the outline is drawn over it.
//
// The view draws with post-processing off, so the colors are written as given: display values, like the image below.
material {
    name: EditorSelectionOutline,
    shadingModel: unlit,
    vertexDomain: device,
    blending: transparent,
    culling: none,
    depthWrite: false,
    depthCulling: false,
    parameters: [
        {type: sampler2d, name: mask, precision: medium},
        {type: float, name: width},
        {type: float3, name: primaryColor},
        {type: float3, name: otherColor}
    ]
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        ivec2 size = textureSize(materialParams_mask, 0);
        ivec2 here = ivec2(gl_FragCoord.xy);
        material.baseColor = vec4(0.0);
        if (texelFetch(materialParams_mask, here, 0).r > 0.0) {
            return;
        }
        int reach = int(ceil(materialParams.width));
        float nearest = 1.0e6;
        float strongest = 0.0;
        for (int y = -reach; y <= reach; ++y) {
            for (int x = -reach; x <= reach; ++x) {
                float m = texelFetch(materialParams_mask, clamp(here + ivec2(x, y), ivec2(0), size - 1), 0).r;
                if (m > 0.0) {
                    nearest = min(nearest, length(vec2(float(x), float(y))));
                    strongest = max(strongest, m);
                }
            }
        }
        float alpha = clamp(materialParams.width + 0.5 - nearest, 0.0, 1.0);
        vec3 color = strongest > 0.75 ? materialParams.primaryColor : materialParams.otherColor;
        // Premultiplied, as transparent blending expects.
        material.baseColor = vec4(color * alpha, alpha);
    }
}

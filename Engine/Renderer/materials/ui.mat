material {
    name: EditorUI,
    parameters: [{type: sampler2d, name: albedo}],
    requires: [uv0, color],
    shadingModel: unlit,
    culling: none,
    depthCulling: false,
    depthWrite: false,
    blending: transparent
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 uv = getUV0();
        uv.y = 1.0 - uv.y;
        material.baseColor = getColor() * texture(materialParams_albedo, uv);
        material.baseColor.rgb *= material.baseColor.a;
    }
}
